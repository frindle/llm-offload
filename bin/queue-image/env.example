# Queue container settings. Copy to .env (git-ignored) next to docker-compose.yml, or enter them as
# variables in the Unraid template. Nothing here is a real value: fill in your own.
# Names only are checked at start (entrypoint.sh); values are never printed.

# ---- network identity (br0 macvlan). No defaults in the committed files: compose stops if these are unset.
QUEUE_IP=CHANGE-ME-fixed-lan-ip
QUEUE_MAC=CHANGE-ME-02:xx:xx:xx:xx:xx

# ---- image
QUEUE_IMAGE=ghcr.io/CHANGE-ME-owner/CHANGE-ME-repo:latest

# ---- host paths (compose only). Put them on the cache pool, never /mnt/user (flock and sqlite WAL need a real filesystem).
QUEUE_APPDATA=/mnt/CHANGE-ME-cache-pool/appdata/ollama-queue

# ---- time zone. log-rotate runs at 04:17 in this zone.
TZ=CHANGE-ME-Area/City

# ---- git (workers commit and push; GitHub is the source of truth)
GIT_AUTHOR_NAME=CHANGE-ME-name
GIT_AUTHOR_EMAIL=CHANGE-ME-email
# fine-grained token limited to the target repos (contents: write)
GITHUB_TOKEN=

# ---- the Mac side
# Darkbloom's local API, pinned to the Mac's LAN address (http://<mac-lan-ip>:8000), and its key
DARKBLOOM_BASE_URL=
DARKBLOOM_API_KEY=
# the Mac status service (queue-agent, port 7691) and its bearer token
QUEUE_AGENT_URL=
QUEUE_AGENT_TOKEN=

# ---- standby: 1 = only the API runs, on a copy of the Mac state; write routes answer 503; nothing notifies.
# Set 0 and restart the container to go live (after the cutover steps).
QUEUE_STANDBY=1

# ---- the queue's own tokens
# bearer token for the API's write routes (the Mac clients send it)
QUEUE_API_TOKEN=
# shared token the CPU runners present (written to ~/.config/dispatch-cpu-runner/token)
CPU_RUNNER_TOKEN=

# ---- GitHub issue intake (mini-issue-poller in this container; a Unraid runner calls the poke route)
# Token for `gh` (list/label/comment/draft PR, issue image attachments). Private-repo attachments need a classic PAT with
# scope `repo` (or an OAuth token); a fine-grained token reportedly fails on them. Written to a 0600 file, then unset.
ISSUE_POLLER_GH_TOKEN=
# Shared secret for POST /api/issue-poke (24+ characters; `openssl rand -hex 24`). The same value goes in the runner's
# .env as ISSUE_POKE_TOKEN, nowhere else. Empty = the route answers 503.
ISSUE_POKE_TOKEN=

# ---- worker secrets (optional; the search keys degrade to SearXNG when empty)
OBSIDIAN_TOKEN=
TAVILY_API=
BRAVE_SEARCH_API=
OLLAMA_WEB_SEARCH=

# ---- container error digest (nightly, error_digest.py): the Loki log stack and its read token (optional; off when empty)
LOKI_URL=
LOKI_TOKEN=
# The digest's daily message (<day>.notify.txt) is also POSTed here once a day when both are set (https only);
# empty = shadow, the file only. The token is the receiving service's bearer token.
ERROR_DIGEST_NOTIFY_URL=
ERROR_DIGEST_NOTIFY_TOKEN=

# ---- Plex first (plex_glacier_watch.py, needs LOKI_*): while Plex plays, no new job on these lanes and idle
# Unraid Ollama models are unloaded. Defaults: on, lane unraid. GLACIER_SHARE_DIR defaults to ~/state/glacier.
#PLEX_GPU_YIELD=1
#PLEX_GPU_LANES=unraid

# ---- prompt jobs (prompt_jobs.py, POST /api/prompt-jobs): apps on the LAN send one prompt and read JSON back, on free
# lanes only. Off (503) while the token is empty. The same token goes in each app's own .env, nowhere else.
QUEUE_PROMPT_TOKEN=
# Unraid Ollama model for them (Darkbloom uses whatever it has loaded) and the lane order. Defaults shown.
#PROMPT_JOB_MODEL=qwen3:8b
#PROMPT_JOB_LANES=darkbloom,unraid

# ---- digest lines (digest_lines.py, POST /api/digest-lines): a LAN app adds a few count lines to the daily error
# email (resell-tracker). Off (503) while the token is empty. The same token goes in that app's .env as
# DIGEST_QUEUE_TOKEN, nowhere else. Allowed apps (comma list), default shown.
QUEUE_DIGEST_TOKEN=
#DIGEST_LINES_APPS=resell

# ---- not set here on purpose
# QUEUE_CONFIG=/config/config.toml and QUEUE_STATE_DIR=/home/queue/state are fixed in the image.
# Hosts, LAN addresses and model-host names live in /config/config.toml and ~/.ollama-dispatch/hosts.json.
# The daemon's GATE_* and BONSAI_CTX values are in supervisord.conf (they are the Mac's tuned values, not secrets).
