# Queue container settings. Copy to .env (git-ignored) next to docker-compose.yml, or enter them as
# variables in the Unraid template. Nothing here is a real value: fill in your own.
# Names only are checked at start (entrypoint.sh); values are never printed.

# ---- network identity (br0 macvlan). No defaults in the committed files: compose stops if these are unset.
QUEUE_IP=CHANGE-ME-fixed-lan-ip
QUEUE_MAC=CHANGE-ME-02:xx:xx:xx:xx:xx

# ---- image
QUEUE_IMAGE=ghcr.io/CHANGE-ME-owner/CHANGE-ME-repo:latest

# ---- host paths (compose only). Put them on the cache pool, never /mnt/user (flock and sqlite WAL need a real filesystem).
QUEUE_APPDATA=/mnt/CHANGE-ME-cache-pool/appdata/ollama-queue

# ---- time zone. log-rotate runs at 04:17 in this zone.
TZ=CHANGE-ME-Area/City

# ---- git (workers commit and push; GitHub is the source of truth)
GIT_AUTHOR_NAME=CHANGE-ME-name
GIT_AUTHOR_EMAIL=CHANGE-ME-email
# fine-grained token limited to the target repos (contents: write)
GITHUB_TOKEN=

# ---- the Mac side
# Darkbloom's local API, pinned to the Mac's LAN address (http://<mac-lan-ip>:8000), and its key
DARKBLOOM_BASE_URL=
DARKBLOOM_API_KEY=
# the Mac status service (queue-agent, port 7691) and its bearer token
QUEUE_AGENT_URL=
QUEUE_AGENT_TOKEN=

# ---- standby: 1 = only the API runs, on a copy of the Mac state; write routes answer 503; nothing notifies.
# Set 0 and restart the container to go live (after the cutover steps).
QUEUE_STANDBY=1

# ---- the queue's own tokens
# bearer token for the API's write routes (the Mac clients send it)
QUEUE_API_TOKEN=
# shared token the CPU runners present (written to ~/.config/dispatch-cpu-runner/token)
CPU_RUNNER_TOKEN=

# ---- worker secrets (optional; the search keys degrade to SearXNG when empty)
OBSIDIAN_TOKEN=
TAVILY_API=
BRAVE_SEARCH_API=
OLLAMA_WEB_SEARCH=

# ---- not set here on purpose
# QUEUE_CONFIG=/config/config.toml and QUEUE_STATE_DIR=/home/queue/state are fixed in the image.
# Hosts, LAN addresses and model-host names live in /config/config.toml and ~/.ollama-dispatch/hosts.json.
# The daemon's GATE_* and BONSAI_CTX values are in supervisord.conf (they are the Mac's tuned values, not secrets).
