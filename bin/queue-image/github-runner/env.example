# Runner settings. Copy to .env next to docker-compose.yml (git-ignored). Nothing here is a real value.
# Image: the Ubuntu 24.04 build of myoung34/github-runner (pin a tag; `latest` is a nightly).
RUNNER_IMAGE=myoung34/github-runner:ubuntu-noble

# Where the queue's poke route is: the queue container's LAN address and port 7684.
ISSUE_POKE_URL=http://CHANGE-ME-queue-lan-ip:7684/api/issue-poke
# The same value as ISSUE_POKE_TOKEN in the queue's .env (24+ characters). It can only ask for one poller tick.
ISSUE_POKE_TOKEN=

# Runner 1: the repo (OWNER/NAME) and a PAT that may register runners on it:
#   fine-grained PAT, only that repo, permission "Administration: Read and write" (nothing else), or
#   classic PAT with scope `repo`. Use a separate token per repo.
RUNNER1_REPO=CHANGE-ME-owner/CHANGE-ME-repo
RUNNER1_ACCESS_TOKEN=
# Its own LAN identity (br0). Ping the address first to check it is free; MAC pattern 02:xx:xx:xx:xx:NN.
RUNNER1_IP=CHANGE-ME-fixed-lan-ip
RUNNER1_MAC=CHANGE-ME-02:xx:xx:xx:xx:xx
