<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- NOT INSTALLED. sandbox-watch.py: read-only sandbox health alerts + limited slot auto-fix (S9). The owner installs:
       cp ~/bin/launchd/com.example.sandbox-watch.plist ~/Library/LaunchAgents/ &&
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.example.sandbox-watch.plist
     Apply patches/sandbox-slots-marker.patch to ~/.darkbloom/sandbox-slots.sh first, so its restarts set the marker.
     Hold all alerts by hand: python3 ~/bin/sandbox-watch.py --set-maintenance 1800 "reason"   (--clear-maintenance ends it)
     Check without side effects: python3 ~/bin/sandbox-watch.py --dry-run -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.sandbox-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/user/bin/sandbox-watch.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/user/.darkbloom/sandbox-watch.log</string>
  <key>StandardErrorPath</key><string>/Users/user/.darkbloom/sandbox-watch.log</string>
</dict>
</plist>
