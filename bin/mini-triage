#!/usr/bin/env python3
"""mini-triage JOB_ID [--write DIR]

Classify a finished mini-swe-runner job's failure from its livelog (+ REVIEW.md in the job's task dir) so a relaunch
fixes the right thing (design: ~/.ollama-dispatch/mini-swe-workflow-design.md). Classes:
  TEST   the frozen/model test was broken or gamed (wrong-reason red, crash in the test, alias/globals hacks)
  SPEC   the spec/task itself is wrong (precheck, bad cwd, contradictory task)
  SIZE   ran out of steps/wall/context: split the step
  MODEL  the model could not produce a passing fix in budget with a sound test
  HACK   the fix was rejected by no_hacks / fn_scope / test edits (TEST-SUSPECT)
  INFRA  host/queue/model-server trouble
Prints `CLASS <X>` plus the matching evidence lines; --write DIR appends a TRIAGE.md entry there.
queue-submit requires TRIAGE.md before relaunching a task family.
"""
import argparse
import os
import re
import sys
import time
from pathlib import Path

LIVE = Path(os.environ.get("MINI_LIVELOG_DIR") or Path.home() / "bin" / "ollama-queue-livelogs")
SIGS = [  # (class, regex) checked in order; an explicit class= tag from the runner wins
    ("INFRA", r"Connection refused|ECONNREFUSED|model .* not found|ollama.*(?:error|unreachable)|CUDA|out of memory|host down|SIGKILL"),
    ("SPEC", r"precheck FAIL|bad spec|bad cwd|cwd_guard|class=SPEC"),
    ("HACK", r"TEST-SUSPECT|no_hacks: FAIL|fn_scope: FAIL|the frozen test was edited"),
    ("TEST", r"UnboundLocalError|NameError: name|wrong-reason red|is not an AssertionError|the test itself is broken|alias|globals\(\)|test REJECTED|supplied .*rejected"),
    ("SIZE", r"step limit|steps exhausted|wall (?:limit|budget)|TIMEOUT|context (?:length|window)|num_ctx"),
    ("MODEL", r"RESULT FAIL|RED:|still red|did not pass"),
]


def find_log(job):
    hits = sorted(LIVE.glob(f"{job}*.livelog"), key=lambda p: p.stat().st_mtime)
    return hits[-1] if hits else None


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("job")
    ap.add_argument("--write", help="dir to append TRIAGE.md to (the relaunch's job dir)")
    a = ap.parse_args()
    log = find_log(a.job)
    if not log:
        print(f"no livelog for {a.job} in {LIVE}")
        return 2
    text = log.read_text(errors="replace")
    m = re.search(r"--task-file\s+(\S+)", text)
    review = Path(m.group(1)).parent / "REVIEW.md" if m else None
    if review and review.is_file():
        text += "\n" + review.read_text(errors="replace")
    tag = re.findall(r"RESULT FAIL.*?\bclass=([A-Z]+)", text)
    cls, ev = (tag[-1], [ln for ln in text.splitlines() if "class=" in ln][-3:]) if tag else (None, [])
    if not cls:
        for c, rx in SIGS:
            lines = [ln.strip() for ln in text.splitlines() if re.search(rx, ln)]
            if lines:
                cls, ev = c, lines[-5:]
                break
    if not cls:
        cls = "PASS" if re.search(r"RESULT PASS", text) else "UNKNOWN"
    print(f"CLASS {cls}  ({log.name})")
    for ln in ev:
        print("  " + ln[:300])
    if a.write:
        t = Path(a.write) / "TRIAGE.md"
        hdr = "" if t.exists() else "# TRIAGE\n\nPrior failures of this task family and what the relaunch changes.\n"
        with t.open("a") as f:
            f.write(hdr + f"\n## {a.job} ({time.strftime('%Y-%m-%d')}): class {cls}\n" + "".join(f"- `{ln[:240]}`\n" for ln in ev))
        print(f"appended {t}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
