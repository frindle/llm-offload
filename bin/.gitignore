# whitelist: ignore everything, then allow source/docs
*
!.gitignore
!*/
!*.py
!*.sh
!*.md
!*.yaml
!*.jinja
!*.plist
!ollama-dispatch*
!ollama-land
!mini-validate
!mini-submit
!mini-triage
!mini-bench
!mini-spec
!mini-graph
!mini-precheck
!mini-throttle
!mini-scorecard
!mini-testdraft
!mini-answer
!mini-finish
!mini-auto
!plan-offload
!vault-log-append
!mini-ledger
!harness-lint
!diagnose-submit
!diagnose-verify
!graphify-all
!offload-repo-sync
!logq
# never
*.bak*
*.orig
*.retired*
*.severed*
*.corrupt*
*.log
*.lock
*.json
*.jsonl
*.tar.gz
__pycache__/
.ruff_cache/
.archive/
.deploy-bak/
.dispatch-auto-sync-backup-*/
*-venv/
*-logs/
*-logs-backups/
*-livelogs/
retired/
retired-launchagents/
test-fixtures*/
vault-embed-index/
llama-swap
gRPCServerCLI
*token*
*secret*
*key*
*.env
*.pem
cashback-unwrap/
!ladder-check
!ladder-log
!graphify-lane
!configs/graphify-lane.json
