<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Durable queue-event log: polls ollama-queue status every 10s, appends terminal
     transitions to ~/.ollama-dispatch/queue-events.jsonl.
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.example.queue-event-log.plist
    launchctl bootout   gui/$(id -u)/com.example.queue-event-log -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.queue-event-log</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/user/bin/queue-event-log.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/user/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/user/bin/ollama-queue-logs/queue-event-log.log</string>
  <key>StandardErrorPath</key><string>/Users/user/bin/ollama-queue-logs/queue-event-log.log</string>
</dict>
</plist>
